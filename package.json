{
  "name": "craft-5-test",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "favicon": "npx --package=cli-real-favicon -- real-favicon generate faviconConfig.json faviconData.json ./web",
    "favicon-update": "npx --package=cli-real-favicon -- real-favicon check-for-update --fail-on-update faviconData.json"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "alpinejs": "^3.10.0",
    "fitvids": "^2.1.1",
    "gsap": "^3.12.2",
    "vanilla-lazyload": "^17.1.3"
  },
  "devDependencies": {
    "@spiriit/vite-plugin-svg-spritemap": "^4.0.1",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-legacy": "^5.4.3",
    "autoprefixer": "^10.3.7",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^7.32.0",
    "penthouse": "^2.3.3",
    "postcss": "^8.3.9",
    "postcss-import": "^16.1.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-critical": "1.0.13",
    "sharp": "^0.32.5",
    "svgo": "^3.0.2",
    "tailwindcss": "^4.1.4",
    "vite": "^5.2.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-image-optimizer": "^1.1.7",
    "vite-plugin-restart": "^0.4.2",
    "vite-plugin-static-copy": "^0.17.0"
  },
  "engines": {
    "node": ">=14"
  },
  "globs": {
    "src": {
      "scss": [
        "./src/scss/**/*.scss"
      ],
      "js": [
        "./src/js/**/*.js"
      ],
      "images": [
        "./src/images/**/*.+(png|jpg|jpeg|gif|svg|ico)",
        "!./src/images/icons/**/*"
      ],
      "icons": [
        "./src/images/icons/**/*.svg"
      ],
      "fonts": [
        "./src/fonts/**/*"
      ],
      "genericAssets": []
    },
    "dist": {
      "css": [
        "./web/assets/css"
      ],
      "js": [
        "./web/assets/js"
      ],
      "images": [
        "./web/assets/images"
      ],
      "icons": [
        "./web/assets/images/icons"
      ],
      "fonts": [
        "./web/assets/fonts"
      ]
    }
  },
  "paths": {
    "srcFolder": "src/",
    "distFolder": "./web/assets",
    "criticalCss": "./templates/_includes/css/critical",
    "templatesFolder": "./templates/**/*.{twig,html}",
    "criticalPages": {
      "home": "/"
    },
    "purgeFiles": [
      "./templates/**/*.{twig,html}",
      "./src/js/**/*.js"
    ]
  }
}
